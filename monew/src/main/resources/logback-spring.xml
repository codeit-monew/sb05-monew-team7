<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Spring Boot ColorConverter 등록 -->
  <conversionRule conversionWord="clr"
    class="org.springframework.boot.logging.logback.ColorConverter"/>

  <!-- 공통 패턴 -->
  <property name="LOG_PATTERN_COLOR"
    value="%d{yy-MM-dd HH:mm:ss.SSS} [%thread] %clr(%5level) %-36logger{36} [%X{requestId} | %X{requestMethod} | %X{requestUri}] - %msg%n"/>

  <!-- ✅ 콘솔 출력 (ECS → CloudWatch Logs로 전송됨) -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN_COLOR}</pattern>
    </encoder>
  </appender>

  <!-- ✅ 루트 로거 -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
